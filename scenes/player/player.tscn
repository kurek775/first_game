; Child of Visual, so it sweeps wherever the character is facing rather than
; wherever the body happens to be moving. Layer 0 / mask 4 ("hurtbox"): nothing
; needs to detect a hitbox, a hitbox only looks for hurtboxes.
[node name="Hitbox" type="Area3D" parent="Visual" node_paths=PackedStringArray("source")]
collision_layer = 0
collision_mask = 8
monitorable = false
script = ExtResource("9_hitbox")

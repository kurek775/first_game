[node name="CameraRig" type="Node3D" parent="."]
script = ExtResource("3_camera")

; Starts pitched 12 degrees down so you can see the ground ahead of the
; character rather than the back of its head. The pivot sits at 2.0 (not eye
; height) so that at this default pitch the arm's sphere clears the ground —
; any lower and the camera snaps in for no visible reason.
[node name="SpringArm3D" type="SpringArm3D" parent="CameraRig"]
transform = Transform3D(1, 0, 0, 0, 0.97815, 0.20791, 0, -0.20791, 0.97815, 0, 2.0, 0)
collision_mask = 1
shape = SubResource("SphereShape3D_arm")
spring_length = 5.0
margin = 0.1


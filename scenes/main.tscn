; Game root. Deliberately thin: environment, sun, player, HUD, and instances of
; the three world scenes. Edit the island in terrain.tscn / monastery.tscn /
; longship.tscn, not here.
;
; Stage 1's flat plane and obstacle course lived here and are now gone -- the
; monastery ramp/stairs and the low wall cover the same movement tests.
[gd_scene load_steps=9 format=3]

[ext_resource type="PackedScene" path="res://scenes/player/player.tscn" id="1_player"]
[ext_resource type="Script" path="res://scripts/ui/debug_hud.gd" id="2_hud"]
[ext_resource type="PackedScene" path="res://scenes/world/terrain.tscn" id="3_terrain"]
[ext_resource type="PackedScene" path="res://scenes/world/monastery.tscn" id="4_monastery"]
[ext_resource type="PackedScene" path="res://scenes/world/longship.tscn" id="5_longship"]

[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_sky"]
sky_top_color = Color(0.29, 0.38, 0.5, 1)
sky_horizon_color = Color(0.6, 0.63, 0.66, 1)
ground_horizon_color = Color(0.6, 0.63, 0.66, 1)
ground_bottom_color = Color(0.2, 0.21, 0.22, 1)

[sub_resource type="Sky" id="Sky_sky"]
sky_material = SubResource("ProceduralSkyMaterial_sky")

[sub_resource type="Environment" id="Environment_env"]
background_mode = 2
sky = SubResource("Sky_sky")
ambient_light_energy = 1.4

[node name="Main" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_env")

; Row-major Transform3D. euler = (-55, -40, 0) degrees; aim is (0.37, -0.82, -0.44).
[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.766, 0.5267, -0.3688, 0, 0.5736, 0.8192, 0.643, -0.6275, 0.4394, 0, 12, 0)
light_energy = 1.1
shadow_enabled = true
directional_shadow_max_distance = 180.0

[node name="Terrain" parent="." instance=ExtResource("3_terrain")]

[node name="Monastery" parent="." instance=ExtResource("4_monastery")]

[node name="Longship" parent="." instance=ExtResource("5_longship")]

; Beached, west of the longship hull, facing north up the island toward the gate.
[node name="Player" parent="." instance=ExtResource("1_player")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6, 0.2, 42)

[node name="DebugHud" type="CanvasLayer" parent="." node_paths=PackedStringArray("player")]
script = ExtResource("2_hud")
player = NodePath("../Player")

[node name="Panel" type="Panel" parent="DebugHud"]
offset_left = 16.0
offset_top = 16.0
offset_right = 300.0
offset_bottom = 200.0

[node name="Label" type="Label" parent="DebugHud/Panel"]
layout_mode = 0
offset_left = 12.0
offset_top = 10.0
offset_right = 272.0
offset_bottom = 180.0
